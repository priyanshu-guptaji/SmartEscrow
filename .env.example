# ============================================================
# SmartEscrow Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and MUST NEVER be committed.
# `.env.example` IS committed as a template — it contains no secrets.

# --- Google Gemini API (for Natural Language Payment Parser) ---
# Get your key at: https://aistudio.google.com/app/apikey
# Leave empty to use the built-in rule-based fallback parser.
GEMINI_API_KEY=

# --- MongoDB Connection (for off-chain payment metadata) ---
# Leave empty to use the local JSON file fallback (src/scratch/db.json)
MONGODB_URI=

# --- Base Sepolia Deployment (Hardhat) ---
# RPC endpoint used by the deploy script (scripts/deploy.ts).
# Defaults to the public endpoint if left empty.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# PRIVATE KEY OF THE DEPLOYER WALLET (server-side only).
# Used ONLY by `npx hardhat run scripts/deploy.ts --network baseSepolia`.
# MUST have the `0x` prefix. MUST be funded with Base Sepolia ETH for gas.
# NEVER prefix this variable with NEXT_PUBLIC_ — it must never reach the browser.
DEPLOYER_PRIVATE_KEY=

# --- Smart Contract (Frontend / public) ---
# Address of the deployed SmartEscrow contract on Base Sepolia.
# Set this AFTER running the deploy script. Required for on-chain transactions.
NEXT_PUBLIC_SMART_ESCROW_ADDRESS=

# Chain ID of the target network (84532 = Base Sepolia).
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532

# Optional RPC override for the frontend wallet/reads.
# If empty, the public Base Sepolia endpoint is used.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Base Sepolia Test ERC-20 Token Addresses ---
# These are official Base Sepolia test tokens. Do NOT change unless deploying custom tokens.
# USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e (6 decimals)
# USDT: 0xf11838B60C0EBf7B2781B7e9A06a5d18B68e3E3e (6 decimals)
# WETH: 0x4200000000000000000000000000000000000006 (18 decimals)
